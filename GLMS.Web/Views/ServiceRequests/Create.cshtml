@model GLMS.API.Models.ServiceRequest

@{
    ViewData["Title"] = "Log Service Request";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">Log Maintenance/Service</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="ContractId" class="form-label">Contract ID</label>
                            <select asp-for="ContractId" class="form-select" asp-items="ViewBag.ContractId"></select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Work Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CostUSD" class="form-label">Estimated Cost (USD)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="CostUSD" class="form-control" type="number" step="0.01" />
                            </div>
                            <small class="text-muted">This will be auto-converted to ZAR on save.</small>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-info text-white">Submit Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

