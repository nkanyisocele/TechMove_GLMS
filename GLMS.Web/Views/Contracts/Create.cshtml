@model GLMS.API.Models.Contract

@{
    ViewData["Title"] = "Create New Contract";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">New Logistics Agreement</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="ClientId" class="form-label">Client / Partner</label>
                                <select asp-for="ClientId" class="form-select" asp-items="ViewBag.ClientId">
                                    <option value="">-- Select Client --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartDate" class="form-label"></label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndDate" class="form-label"></label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label"></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Draft">Draft</option>
                                    <option value="Active">Active</option>
                                    <option value="On Hold">On Hold</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServiceLevel" class="form-label">SLA Level</label>
                                <select asp-for="ServiceLevel" class="form-select">
                                    <option value="Standard">Standard</option>
                                    <option value="Premium">Premium (24/7)</option>
                                    <option value="Enterprise">Enterprise (VIP)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Signed PDF Agreement (Requirement)</label>
                            <input type="file" name="pdfFile" class="form-control" accept=".pdf" />
                            <small class="text-muted">Only PDF files are accepted for legal compliance.</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Register Contract</button>
                            <a asp-action="Index" class="btn btn-link text-secondary">Back to Hub</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
